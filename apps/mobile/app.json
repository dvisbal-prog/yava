{
  "expo": {
    "name": "YAVA",
    "slug": "yava",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yava",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "co.yava.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "YAVA usa tu ubicación para mostrarte comercios cercanos y calcular la entrega.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Los repartidores comparten su ubicación durante las entregas.",
        "NSCameraUsageDescription": "Toma fotos de tus productos y documentos.",
        "NSPhotoLibraryUsageDescription": "Selecciona fotos de tus productos y documentos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.yava.app",
      "adaptiveIcon": {
        "backgroundColor": "#FECB14",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Los repartidores comparten su ubicación durante las entregas.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona fotos de tus productos y documentos.",
          "cameraPermission": "Toma fotos de tus productos y documentos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E5EFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "zds-agency",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2e5ba82e-1aa1-4698-a00e-745181c1f4b4"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2e5ba82e-1aa1-4698-a00e-745181c1f4b4"
    }
  }
}
